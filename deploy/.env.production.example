# Copier vers backend/.env sur le serveur puis compléter.
PORT=3100

DB_HOST=127.0.0.1
DB_PORT=5440
DB_USER=leto
# Générer : openssl rand -hex 24
DB_PASSWORD=
DB_NAME=leto
# Crée / met à jour les tables au démarrage
DB_SYNC=true

# Générer : openssl rand -hex 48
JWT_SECRET=

# Compte Super Admin : créé au premier démarrage, puis mis à jour à chaque redémarrage si ces valeurs changent.
# Mettez le mot de passe entre guillemets s'il contient # ou des espaces : SUPER_ADMIN_PASSWORD="Mon#MotDePasse"
SUPER_ADMIN_PHONE=0700000000
SUPER_ADMIN_PASSWORD=

# Origine du back-office autorisée à appeler l'API
CORS_ORIGIN=https://leto.vite.ci,https://vite.ci

# Attente minimale (minutes) avant de pouvoir signaler un destinataire absent (réglable ensuite dans le back-office)
ABSENCE_WAIT_MIN=5

# Optionnel : Google (recherche de lieux, adresses, itinéraires) en complément d'OpenStreetMap
GOOGLE_MAPS_API_KEY=

# Stockage des photos sur Wasabi (vide = dossier local uploads/)
WAS_ACCESS_KEY=
WAS_SECRET_KEY=
WASABI_REGION=eu-central-1
WASABI_BUCKET=
WASABI_IDENTITY_BUCKET=
WASABI_ENDPOINT=https://s3.eu-central-1.wasabisys.com
WASABI_URL=https://s3.eu-central-1.wasabisys.com
