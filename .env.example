PORT=3000
DB_HOST=localhost
DB_PORT=5440
DB_USER=leto
DB_PASSWORD=leto
DB_NAME=leto
JWT_SECRET=change-moi-en-production
# Compte Super Admin (SA) créé automatiquement au premier démarrage
SUPER_ADMIN_PHONE=0700000000
SUPER_ADMIN_PASSWORD=admin1234
# Optionnel : active Google (recherche de lieux, adresses, itinéraires) en complément d'OpenStreetMap
GOOGLE_MAPS_API_KEY=
# Attente minimale (minutes) avant de pouvoir signaler un destinataire absent
ABSENCE_WAIT_MIN=5
# Stockage des fichiers sur Wasabi (compatible S3). Vide = dossier local uploads/
WAS_ACCESS_KEY=
WAS_SECRET_KEY=
WASABI_REGION=eu-central-1
WASABI_BUCKET=
# Bucket séparé pour les pièces d'identité (livreurs)
WASABI_IDENTITY_BUCKET=
WASABI_ENDPOINT=https://s3.eu-central-1.wasabisys.com
WASABI_URL=https://s3.eu-central-1.wasabisys.com
